# ===== คัดลอกเป็น .env แล้วแก้ค่า (ห้ามอัปโหลด .env ขึ้น GitHub / ห้ามส่งให้ใคร) =====
NODE_ENV=production
PORT=3000

# ฐานข้อมูล PostgreSQL ของคุณเอง
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/movieflix

# สร้างด้วย:  openssl rand -hex 32   (ค่าสองตัวนี้ต้องต่างกัน และห้ามเปลี่ยนหลังเริ่มใช้ APP_ENC_KEY)
APP_ENC_KEY=
APP_CSRF_SECRET=

# อยู่หลัง nginx / Cloudflare ให้ตั้งเป็น 1 เพื่อให้เห็น IP จริงของผู้เข้าใช้
TRUST_PROXY=1

# หน้าตาอยู่คนละโดเมนกับ API? ใส่ origin ของหน้าตาที่นี่ (เช่น https://admin.example.com)
# ปล่อยว่าง = ไม่เปิด CORS (แนะนำ: ให้หน้าตากับ API อยู่โดเมนเดียวกัน)
ALLOWED_ORIGIN=

SESSION_HOURS=8
ASSET_BASE_URL=

# ===== SeriesJeen (คีย์อยู่ที่เซิร์ฟเวอร์เท่านั้น) =====
# ถ้าเคยกรอกคีย์ในหลังบ้านตัวเดิมที่เปิดบนเว็บจริง ให้สร้างคีย์ใหม่ที่ SeriesJeen แล้วยกเลิกคีย์เก่า
SERIESJEEN_API_KEY=
# คีย์ย่อยสำหรับฝั่งผู้ชม (ไม่บังคับ ขึ้นต้น sjv2s_)
SERIESJEEN_V2_SUBKEY=
